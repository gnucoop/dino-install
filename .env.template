# =============================================================================
# Dino environment — generated by setup.sh from .env.template
# Do NOT edit the placeholders by hand; run ./setup.sh instead.
# =============================================================================

# --- ADMIN ---
ADMIN_EMAIL=__ADMIN_EMAIL__
# Hasura admin secret (also the console password). Auto-generated.
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# --- DINO ADMIN USER ---
# Display name for the web login user seeded by postinstall.sql. The login
# email/password reuse ADMIN_EMAIL / ADMIN_PASSWORD above.
USER_DISPLAY_NAME=__USER_DISPLAY_NAME__

# --- GENERAL / DOMAIN ---
# Internal compose service names (do not change).
HASURA_URL=graphql
AUTH_URL=auth
STORAGE_URL=storage
# Public hostnames, all derived from your single BASE_DOMAIN.
CLIENT_URL=dino.__BASE_DOMAIN__
PUBLIC_STORAGE_URL=storage.__BASE_DOMAIN__

# --- NGINX / EDGE ---
NGINX_VERSION=latest
HTTP_PORT=80
HTTPS_PORT=443

# --- DINO SPA ---
DINOAPP_VERSION=latest
# Host port the SPA container (nginx on :80) is published on; nginx proxies here.
DINOAPP_HOST_PORT=8090
# Instance name baked into the running SPA container.
INSTANCE_NAME=__INSTANCE_NAME__
# Public API endpoints the SPA talks to (all derived from BASE_DOMAIN).
DINOAPP_AUTH_URL=https://auth.__BASE_DOMAIN__/v1
DINOAPP_GRAPHQL_URL=https://hasura.__BASE_DOMAIN__/v1/graphql
DINOAPP_WS_URL=wss://hasura.__BASE_DOMAIN__/v1/graphql

# --- POSTGRES ---
POSTGRES_VERSION=pg17
DB_NAME=postgres
DINO_DB_NAME=postgres
PG_PASSWORD=__PG_PASSWORD__
PG_USER=postgres
PG_ADDRESS=postgres
PG_PORT=5432
PGVECTORDB=postgres

# --- HASURA ---
HASURA_VERSION=v2.48.10-ce.cli-migrations-v3
HASURA_GRAPHQL_SERVER_PORT=8080
YOUR_HASURA_PORT=9000
HASURA_GRAPHQL_UNAUTHORIZED_ROLE=public
HASURA_GRAPHQL_ENABLE_CONSOLE=true
HASURA_GRAPHQL_JWT_SECRET='{"type":"HS256", "key":"__JWT_KEY__"}'
HASURA_METADATA=./nhost_apps/nhost/metadata
HASURA_MIGRATIONS=./nhost_apps/nhost/migrations

# --- AUTH ---
HASURA_AUTH_VERSION=0.47.0
AUTH_PORT=4000
YOUR_AUTH_PORT=9001
AUTH_ENCRYPTION_KEY=__AUTH_ENCRYPTION_KEY__
AUTH_ACCESS_CONTROL_ALLOWED_REDIRECT_URLS=reset-password
AUTH_EMAIL_TEMPLATE=./nhost_apps/nhost/emails
AUTH_LOG_LEVEL=info
AUTH_LOCALE_ALLOWED_LOCALES=en
AUTH_LOCALE_DEFAULT=en
AUTH_EMAIL_SIGNIN_EMAIL_VERIFIED_REQUIRED=false
# SMTP (leave blank to disable transactional email).
AUTH_SMTP_HOST=__AUTH_SMTP_HOST__
AUTH_SMTP_PORT=__AUTH_SMTP_PORT__
AUTH_SMTP_USER=__AUTH_SMTP_USER__
AUTH_SMTP_PASS=__AUTH_SMTP_PASS__
AUTH_SMTP_SENDER=__AUTH_SMTP_SENDER__
AUTH_SMTP_AUTH_METHOD=LOGIN
AUTH_SMTP_SECURE=false

# --- STORAGE / MINIO ---
HASURA_STORAGE_VERSION=0.6.0
STORAGE_PORT=8000
YOUR_STORAGE_PORT=9002
MINIO_VERSION=latest
MC_VERSION=latest
# Host port for the MinIO S3 API (container serves on :9000).
MINIO_API_PORT=9006
# MinIO console port (used on both host and container side).
MINIO_CONSOLE_PORT=32765
S3_ENDPOINT=http://minio:9000
S3_BUCKET=default
S3_REGION=us-east-1
S3_ACCESS_KEY=__S3_ACCESS_KEY__
S3_SECRET_KEY=__S3_SECRET_KEY__
