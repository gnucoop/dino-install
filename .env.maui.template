# --- MAUI (pandino AI service) ---
# Appended to .env by `./setup.sh --maui`; the service lives in
# docker-compose.maui.yml. Postgres settings reuse the POSTGRES block above.
MAUI_VERSION=latest
# Host port the container (:5000) is published on; nginx proxies here.
MAUI_PORT=5000
MAUI_PUBLIC_URL=maui.__BASE_DOMAIN__
MAUI_ENCRYPTION_KEY=__MAUI_ENCRYPTION_KEY__
# maui's own admin login. The hash is bcrypt; single quotes keep Compose from
# expanding its '$'. Regenerate with:  htpasswd -nbBC 12 "" 'new-password' | tr -d ':\n'
ADMIN_USERNAME=__MAUI_ADMIN_USERNAME__
ADMIN_PASSWORD_HASH='__MAUI_ADMIN_PASSWORD_HASH__'
# Provider API keys (blank = provider unused).
STRIPE_SK_KEY=__STRIPE_SK_KEY__
DEEPINFRA_API_KEY=__DEEPINFRA_API_KEY__
MISTRAL_API_KEY=__MISTRAL_API_KEY__
# Models / providers — fill these in for your deployment.
DATACHAT_MODEL=
DATACHAT_PROVIDER=
PROMPT_MODEL=
PROMPT_PROVIDER=
COMPLETION_MODEL=
COMPLETION_MODEL_PROVIDER=
COMPLETION_EMBEDDING_MODEL=
COMPLETION_EMBEDDING_MODEL_PROVIDER=
COMPLETION_MODEL_AGENT_CHAT=
VISION_PROVIDER=
VISION_MODEL=
AUDIO_PROVIDER=
AUDIO_MODEL=
WHISPER_MODEL=
OLLAMA_BASE_URL=
MAUI_SCHEMA=
# Token costs — fill these in for your deployment.
DATACHAT_TOKEN_COST=
COMPLETION_TOKEN_COST=
PROMPT_TOKEN_COST=
AUDIO_FORM_TOKEN_COST=
