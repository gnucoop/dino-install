# --- MCP (data analysis connector) ---
# Read-only MCP server: lets Claude analyse this deployment's collected data,
# scoped by each caller's own Dino permissions. Appended to .env by
# `./setup.sh --mcp`; the service lives in docker-compose.mcp.yml.
MCP_VERSION=1.0.2
# Port inside the container.
MCP_PORT=3000
# Host port the container is published on; nginx proxies here. The service
# speaks plain HTTP, so nothing but nginx should reach it: Docker's published
# ports bypass host firewalls such as ufw, so block this port at the network
# edge.
MCP_HOST_PORT=9003
# Host address the port is published on (blank = 0.0.0.0, every interface).
# nginx reaches the service through the Docker host gateway, which needs the
# default; set 127.0.0.1 only if the proxy in front runs on the host itself.
MCP_HOST_BIND=
MCP_PUBLIC_URL=mcp.__BASE_DOMAIN__
MCP_ENCRYPTION_KEY=__MCP_ENCRYPTION_KEY__
# The dedicated read-only Postgres role the service uses for every query. The
# container creates it and grants it on boot; MCP_DATABASE_URL is built from it.
# Lowercase identifier only.
MCP_DB_USER=dino_mcp_ro
# Its password. Change it here to rotate the credential.
MCP_DB_PASSWORD=__MCP_DB_PASSWORD__
# Renaming MCP_DB_USER is refused while the old role still exists, so a
# fully-granted role is never left behind. Set this to true for one boot to have
# the service drop the old role as part of the rename.
MCP_DB_USER_REPLACE=false
# These two MUST match the SPA build: environment.usersConfig.adminRoles and
# environment.optionalModulesConfig. If they disagree, MCP answers disagree
# with what the app shows.
MCP_ADMIN_ROLES=admin
MCP_ACTIVE_METRICS=area,case,location,organization,project
# Caps per tool call.
MCP_MAX_ROWS=5000
MCP_MAX_RESPONSE_BYTES=1000000
MCP_STATEMENT_TIMEOUT_MS=15000
# form_data ships with no usable indexes; the container adds them on boot.
# Set to false to leave the schema untouched.
MCP_CREATE_INDEXES=true
# Comma-separated formName:fieldName (or bare fieldName) never to return.
MCP_REDACT_FIELDS=
MCP_LOG_LEVEL=info
# Reverse proxies in front of the service (nginx = 1). It decides which
# X-Forwarded-For entry the rate limiters treat as the caller.
MCP_TRUST_PROXY=1

