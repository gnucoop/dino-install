events {
}

http {
    include /etc/nginx/mime.types;
    http2 on;

    # WebSocket upgrade helper: "upgrade" for WS handshakes, "close" otherwise.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ---- Dino SPA (static) ----
    server {
        listen 80;
        listen 443 ssl;
        server_name dino.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/access.log;
        error_log  /var/log/nginx/error.log;

        location / {
            proxy_http_version 1.1;
            proxy_pass http://dinoapp/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
        }
    }

    # ---- Auth ----
    server {
        listen 443 ssl;
        server_name auth.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/auth-access.log;
        error_log  /var/log/nginx/auth-error.log;

        location / {
            return 301 /v1$request_uri;
        }

        location /v1/ {
            add_header X-Cache-Status $upstream_cache_status;
            proxy_ignore_headers Cache-Control;
            proxy_http_version 1.1;
            # No trailing slash: forward the /v1 prefix intact so it matches the
            # auth service's AUTH_API_PREFIX=/v1 (a trailing slash would strip /v1
            # and every endpoint would 404).
            proxy_pass http://auth;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header  Authorization;
            proxy_hide_header x-powered-by;
        }
    }

    # ---- Hasura GraphQL ----
    server {
        listen 443 ssl;
        server_name hasura.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/hasura-access.log;
        error_log  /var/log/nginx/hasura-error.log;

        location / {
            add_header X-Cache-Status $upstream_cache_status;
            proxy_ignore_headers Cache-Control;
            proxy_http_version 1.1;
            proxy_pass http://hasura/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header  Authorization;
            proxy_hide_header x-powered-by;
        }
    }

    # ---- Storage ----
    server {
        listen 443 ssl;
        server_name storage.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/storage-access.log;
        error_log  /var/log/nginx/storage-error.log;

        location / {
            add_header X-Cache-Status $upstream_cache_status;
            proxy_ignore_headers Cache-Control;
            proxy_http_version 1.1;
            proxy_pass http://storage/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header  Authorization;
            proxy_hide_header x-powered-by;
        }
    }

    # ---- MinIO S3 API ----
    server {
        listen 443 ssl;
        server_name minio.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/minio-access.log;
        error_log  /var/log/nginx/minio-error.log;

        location / {
            add_header X-Cache-Status $upstream_cache_status;
            proxy_ignore_headers Cache-Control;
            proxy_http_version 1.1;
            proxy_pass http://minio/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header  Authorization;
            proxy_hide_header x-powered-by;
        }
    }

    # ---- MinIO Console ----
    server {
        listen 443 ssl;
        server_name minio-console.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/minio-console-access.log;
        error_log  /var/log/nginx/minio-console-error.log;

        location / {
            add_header X-Cache-Status $upstream_cache_status;
            proxy_ignore_headers Cache-Control;
            proxy_http_version 1.1;
            proxy_pass http://minioconsole/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header  Authorization;
            proxy_hide_header x-powered-by;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
        }
    }

    # @mcp-begin  (kept only with ./setup.sh --mcp)
    # ---- MCP (Claude data-analysis connector) ----
    server {
        listen 443 ssl;
        server_name mcp.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/mcp-access.log;
        error_log  /var/log/nginx/mcp-error.log;

        location / {
            proxy_http_version 1.1;
            proxy_pass http://mcp/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header Authorization;
            proxy_hide_header x-powered-by;

            # Streamable HTTP / SSE: responses are long-lived and must not be
            # buffered, or the connector hangs with nothing on the wire.
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            chunked_transfer_encoding on;
        }
    }

    # @mcp-end
    # @maui-begin  (kept only with ./setup.sh --maui)
    # ---- maui (pandino AI service) ----
    server {
        listen 443 ssl;
        server_name maui.__BASE_DOMAIN__;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        access_log /var/log/nginx/maui-access.log;
        error_log  /var/log/nginx/maui-error.log;

        location / {
            proxy_http_version 1.1;
            proxy_pass http://maui/;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Port  $server_port;
            proxy_set_header Authorization $http_authorization;
            proxy_pass_header Authorization;
            proxy_hide_header x-powered-by;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 600s;
        }
    }

    # @maui-end
    upstream dinoapp {
        server __UPSTREAM_HOST__:__DINOAPP_HOST_PORT__;
    }

    upstream hasura {
        server __UPSTREAM_HOST__:__YOUR_HASURA_PORT__;
    }

    upstream auth {
        server __UPSTREAM_HOST__:__YOUR_AUTH_PORT__;
    }

    upstream storage {
        server __UPSTREAM_HOST__:__YOUR_STORAGE_PORT__;
    }

    upstream minio {
        server __UPSTREAM_HOST__:__MINIO_API_PORT__;
    }

    upstream minioconsole {
        server __UPSTREAM_HOST__:__MINIO_CONSOLE_PORT__;
    }
    # @mcp-begin

    upstream mcp {
        server __UPSTREAM_HOST__:__MCP_HOST_PORT__;
    }
    # @mcp-end
    # @maui-begin

    upstream maui {
        server __UPSTREAM_HOST__:__MAUI_PORT__;
    }
    # @maui-end
}
